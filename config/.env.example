# Copy to a path OUTSIDE the webroot in production and point POLICE_ENV_FILE at it.
# Example (Apache httpd.conf / vhost):
#   SetEnv POLICE_ENV_FILE "C:/ProgramData/police_db/.env"
# Or place file at: <parent-of-app>/.police_db.env
#
# Generate secrets:
#   DB pass:  C:\xampp\php\php.exe -r "echo bin2hex(random_bytes(18)), PHP_EOL;"
#   ENC key:  C:\xampp\php\php.exe -r "echo base64_encode(random_bytes(32)), PHP_EOL;"

APP_ENV=production
FORCE_HTTPS=1
APP_DEBUG=0

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=police_db_security
DB_USER=police_app
DB_PASS=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD
DB_CHARSET=utf8mb4

# AES-256-GCM key (32 raw bytes, base64). Rotating makes ENC1: data undecryptable.
ENC_KEY_B64=CHANGE_ME_BASE64_32_BYTE_KEY

# Optional: full path to mysqldump for docs\backup_run.php
# MYSQLDUMP_BIN=C:\xampp\mysql\bin\mysqldump.exe
